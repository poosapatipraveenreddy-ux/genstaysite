{
  "name": "BareTime — Custom Clock",
  "short_name": "BareTime",
  "description": "A fully customizable clock that works offline. Transparent, color and glass styles, 26 fonts, your own wallpaper.",
  "start_url": "/clock",
  "scope": "/clock",
  "id": "/clock",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#0b0b0f",
  "theme_color": "#0b0b0f",
  "categories": ["utilities", "lifestyle"],
  "icons": [
    { "src": "/clock/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/clock/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/clock/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
